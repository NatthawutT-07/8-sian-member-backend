generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Member {
  id String @id @default(uuid())
  memberNumber Int @unique @default(autoincrement())
  firstName String
  lastName String
  phone String? @unique
  lineUserId String? @unique
  lineDisplayName String?
  loyaltyQrHash String? @unique
  loyaltyQrExpiresAt DateTime?
  passwordHash String?
  birthDate DateTime? @db.Date
  marketingConsent Boolean @default(false)
  privacyVersion String @default("2026-10-25")
  consentedAt DateTime @default(now())
  createdAt DateTime @default(now())
  sessions Session[]
  coupons Coupon[]
  diningVisits DiningVisit[]
}
model DiningVisit {
  id String @id @default(uuid())
  memberId String
  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  receiptNumber String @unique
  recordedBy String
  createdAt DateTime @default(now())
  @@index([memberId, createdAt])
}
model LineAuthFlow {
  tokenHash String @id
  stateHash String?
  nonce String?
  verifier String?
  lineUserId String?
  displayName String?
  linkExisting Boolean @default(false)
  expiresAt DateTime
  @@index([expiresAt])
}
model Session {
  tokenHash String @id
  memberId String
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}
model Coupon {
  id String @id @default(uuid())
  memberId String
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  campaign String
  offer Campaign @relation(fields: [campaign], references: [id])
  issuedAt DateTime @default(now())
  expiresAt DateTime
  usedAt DateTime?
  barcodeTokenHash String? @unique
  barcodeExpiresAt DateTime?
  posReservation PosCouponReservation?
  posSale PosSale?
  @@unique([memberId, campaign])
  @@index([memberId, usedAt, expiresAt])
}
model Campaign {
  id String @id @default(uuid())
  title String
  description String
  extraPrice Int @default(0)
  /// Legacy value retained for old data; POS discount is derived from extraPrice.
  posDiscountSatang Int @default(0)
  posMinSubtotalSatang Int @default(0)
  validityDays Int @default(30)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  coupons Coupon[]
  prerequisiteCampaignId String?
  prerequisite Campaign? @relation("CampaignSequence", fields: [prerequisiteCampaignId], references: [id], onDelete: Restrict)
  nextCampaigns Campaign[] @relation("CampaignSequence")
  @@index([prerequisiteCampaignId])
}
model Admin {
  id String @id @default("owner")
  username String @unique
  passwordHash String
  role String @default("ADMIN")
  createdAt DateTime @default(now())
  sessions AdminSession[]
}
model AdminSession {
  tokenHash String @id
  adminId String
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}
model AuditLog {
  id String @id @default(uuid())
  actor String
  action String
  memberId String?
  details Json
  createdAt DateTime @default(now())
  @@index([memberId, createdAt])
}

model PosProduct {
  id String @id @default(uuid())
  barcode String @unique
  name String
  priceSatang Int
  group String @default("MAIN")
  active Boolean @default(true)
  createdAt DateTime @default(now())
}

model PosSale {
  id String @id @default(uuid())
  receiptNumber String @unique
  key String @unique
  requestHash String
  actor String
  items Json
  totalSatang Int
  subtotalSatang Int?
  discountSatang Int @default(0)
  couponId String? @unique
  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: Restrict)
  couponTitle String?
  method String
  receivedSatang Int
  changeSatang Int
  memberId String?
  tableId String?
  tableNumber Int?
  tableSessionId String?
  shiftId String?
  shift PosShift? @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([shiftId])
  @@index([createdAt])
}

model DiningTable {
  id String @id @default(uuid())
  number Int @unique
  qrToken String @unique @default(uuid())
  sessionId String? @unique
  orderingEnabled Boolean @default(false)
  zones Json @default("[]")
  openedAt DateTime?
  openedBy String?
  closedAt DateTime?
  version Int @default(0)
  createdAt DateTime @default(now())
  orders TableOrder[]
}

model OrderingCategory {
  name String @id
  sortOrder Int @default(0)
}

model OrderingMenuItem {
  id String @id @default(uuid())
  zone String
  category String
  name String
  active Boolean @default(true)
  imageData Bytes?
  imageMime String?
  imageVersion String?
  createdAt DateTime @default(now())
  @@unique([zone, category, name])
}

model TableOrder {
  id String @id @default(uuid())
  key String @unique
  requestHash String
  tableId String
  table DiningTable @relation(fields: [tableId], references: [id], onDelete: Restrict)
  sessionId String
  items Json
  status String @default("NEW")
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@index([status, createdAt])
  @@index([tableId, sessionId])
}

model PosCouponReservation {
  id String @id @default(uuid())
  couponId String @unique
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  billKey String @unique
  actor String
  barcodeHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

model PosReceiptCounter {
  businessDate String @id
  lastNumber Int
}

model PosUser {
  id String @id @default(uuid())
  username String @unique
  displayName String
  passwordHash String
  role String @default("USER")
  active Boolean @default(true)
  createdAt DateTime @default(now())
  sessions PosSession[]
}

model PosSession {
  tokenHash String @id
  userId String
  user PosUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}

model PosShift {
  id String @id @default(uuid())
  activeSlot String? @unique
  businessDate String
  openedBy String
  openedAt DateTime @default(now())
  openingCashSatang Int
  closedBy String?
  closedAt DateTime?
  countedCashSatang Int?
  expectedCashSatang Int?
  cashDifferenceSatang Int?
  version Int @default(0)
  sales PosSale[]
  @@index([businessDate])
}
